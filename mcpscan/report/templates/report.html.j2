<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>MCPScan Report</title>
  <style>
    :root { color-scheme: light dark; }
    body { font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, sans-serif;
           margin: 0; background: #0b0f17; color: #e6edf3; }
    header { padding: 24px 32px; background: #111826; border-bottom: 1px solid #1f2a3a; }
    h1 { margin: 0; font-size: 20px; }
    .meta { color: #93a1b5; font-size: 13px; margin-top: 6px; }
    main { padding: 24px 32px; max-width: 1100px; margin: 0 auto; }
    .cards { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 24px; }
    .card { background: #111826; border: 1px solid #1f2a3a; border-radius: 10px;
            padding: 14px 18px; min-width: 110px; }
    .card .n { font-size: 26px; font-weight: 700; }
    .critical { color: #ff5c7a; } .high { color: #ff8f5c; }
    .medium { color: #ffd25c; } .low { color: #7cc5ff; } .info { color: #93a1b5; }
    table { width: 100%; border-collapse: collapse; font-size: 14px; }
    th, td { text-align: left; padding: 10px 12px; border-bottom: 1px solid #1f2a3a;
             vertical-align: top; }
    th { color: #93a1b5; font-weight: 600; }
    .badge { display: inline-block; padding: 2px 8px; border-radius: 999px; font-size: 12px;
             border: 1px solid currentColor; }
    code { background: #0b0f17; padding: 1px 5px; border-radius: 5px; }
    pre.mermaid { background: #111826; border: 1px solid #1f2a3a; border-radius: 10px;
                  padding: 16px; overflow: auto; }
    footer { padding: 16px 32px; color: #64748b; font-size: 12px; }
  </style>
</head>
<body>
  <header>
    <h1>MCPScan Security Report</h1>
    <div class="meta">
      Scanner v{{ result.scanner_version }} &middot; mode: {{ result.mode }} &middot;
      risk score: <strong>{{ result.risk_score }}/100</strong> &middot;
      findings hash: <code>{{ findings_hash[:16] }}</code>
    </div>
  </header>
  <main>
    <section class="cards">
      {% for level in ["critical", "high", "medium", "low", "info"] %}
      <div class="card">
        <div class="n {{ level }}">{{ counts[level] }}</div>
        <div class="{{ level }}">{{ level | upper }}</div>
      </div>
      {% endfor %}
    </section>

    <h2>Findings ({{ result.findings | length }})</h2>
    <table>
      <thead>
        <tr><th>Severity</th><th>Rule</th><th>OWASP</th><th>Tool</th><th>Detail</th><th>Conf.</th></tr>
      </thead>
      <tbody>
        {% for f in result.findings %}
        <tr>
          <td><span class="badge {{ f.severity.value }}">{{ f.severity.value | upper }}</span></td>
          <td><code>{{ f.rule_id }}</code></td>
          <td>{{ f.owasp_mcp_id or "-" }}</td>
          <td>{{ f.tool or "-" }}</td>
          <td>
            <strong>{{ f.title }}</strong><br />
            {{ f.message }}
            {% if f.evidence.get("snippet") %}<br /><code>{{ f.evidence["snippet"] }}</code>{% endif %}
          </td>
          <td>{{ "%.2f" | format(f.confidence) }}{% if f.ai_assisted %} 🤖{% endif %}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>

    {% if mermaid %}
    <h2>Capability Graph</h2>
    <pre class="mermaid">{{ mermaid }}</pre>
    <script type="module">
      try {
        const m = await import("https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.esm.min.mjs");
        m.default.initialize({ startOnLoad: true, theme: "dark" });
      } catch (e) { /* offline: raw mermaid text remains readable */ }
    </script>
    {% endif %}
  </main>
  <footer>Generated by MCPScan &mdash; OWASP MCP Top 10 aligned.</footer>
</body>
</html>
